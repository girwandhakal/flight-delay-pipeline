{
  "datasets": {
    "bts": {
      "start_month": "2024-01",
      "end_month": "2025-01",
      "output_directory": "data/bronze/bts"
    },
    "weather": {
      "product": "lcdv2",
      "output_directory": "data/bronze/weather",
      "reference_directory": "data/reference/weather/2024-2025-v1"
    },
    "taf": {
      "bronze_directory": "data/bronze/taf",
      "silver_directory": "data/silver/taf",
      "station_limit": 50
    },
    "sigmets": {
      "bronze_directory": "data/bronze/sigmets",
      "silver_directory": "data/silver/sigmets"
    }
  },
  "modeling": {
    "target": "ArrDel15",
    "prediction_cutoff": "scheduled departure",
    "random_seed": 42
  },
  "bts_features": {
    "rolling_window_minutes": 120,
    "outbound_schedule_slack": {
      "release_manifest": "data/bronze/bts_block_history/manifest.json",
      "bts_archive_dates": {
        "2024-01": "2024-04-11",
        "2024-02": "2024-05-13",
        "2024-03": "2024-05-29",
        "2024-04": "2024-07-18",
        "2024-05": "2024-08-09",
        "2024-06": "2024-08-30",
        "2024-07": "2024-09-27",
        "2024-08": "2024-10-21",
        "2024-09": "2024-12-11"
      }
    }
  },
  "splits": {
    "train": {
      "start_date": "2024-01-01",
      "end_date": "2024-09-30"
    },
    "val": {
      "start_date": "2024-10-01",
      "end_date": "2024-11-30"
    },
    "test": {
      "start_date": "2024-12-01",
      "end_date": "2025-01-31"
    }
  },
  "required_columns": [
    "FlightDate",
    "DayOfWeek",
    "Reporting_Airline",
    "Flight_Number_Reporting_Airline",
    "Origin",
    "Dest",
    "CRSDepTime",
    "CRSArrTime",
    "CRSElapsedTime",
    "DepTime",
    "DepDelay",
    "ArrTime",
    "ArrDelay",
    "Distance",
    "ArrDel15",
    "Cancelled",
    "Diverted"
  ],
  "origin_weather": {
    "max_age_minutes": 120
  },
  "destination_weather": {
    "reference_directory": "data/reference/weather/2024-2025-destination-v1"
  }
}
