{
  "datasets": {
    "bts": {
      "start_month": "2024-01",
      "end_month": "2025-01",
      "output_directory": "data/bronze/bts"
    }
  },
  "modeling": {
    "target": "ArrDel15",
    "prediction_cutoff": "scheduled departure",
    "random_seed": 42
  },
  "splits": {
    "train": {
      "start_date": "2024-01-01",
      "end_date": "2024-09-30"
    },
    "val": {
      "start_date": "2024-10-01",
      "end_date": "2024-11-30"
    },
    "test": {
      "start_date": "2024-12-01",
      "end_date": "2025-01-31"
    }
  },
  "required_columns": [
    "FlightDate",
    "DayOfWeek",
    "Reporting_Airline",
    "Flight_Number_Reporting_Airline",
    "Origin",
    "Dest",
    "CRSDepTime",
    "CRSArrTime",
    "CRSElapsedTime",
    "Distance",
    "ArrDel15",
    "Cancelled",
    "Diverted"
  ]
}
