{
  "datasets": {
    "bts": {
      "start_month": "2024-01",
      "end_month": "2026-01",
      "output_directory": "data/bronze/bts"
    },
    "weather": {
      "product": "lcdv2",
      "output_directory": "data/bronze/weather"
    },
    "taf": {
      "bronze_directory": "data/bronze/taf",
      "silver_directory": "data/silver/taf",
      "station_limit": 50
    },
    "sigmets": {
      "bronze_directory": "data/bronze/sigmets",
      "silver_directory": "data/silver/sigmets"
    }
  },
  "modeling": {
    "target": "ArrDel15",
    "prediction_cutoff": "scheduled departure",
    "random_seed": 42
  },
  "bts_features": {
    "rolling_window_minutes": 120
  },
  "split_percentages": {
    "train": 70,
    "val": 15,
    "test": 15
  },
  "required_columns": [
    "FlightDate",
    "DayOfWeek",
    "Reporting_Airline",
    "Flight_Number_Reporting_Airline",
    "Origin",
    "Dest",
    "CRSDepTime",
    "CRSArrTime",
    "CRSElapsedTime",
    "DepTime",
    "DepDelay",
    "ArrTime",
    "ArrDelay",
    "Distance",
    "ArrDel15",
    "Cancelled",
    "Diverted"
  ],
  "origin_weather": {
    "reference_directory": "data/reference/weather/2024-2025-origin-v1",
    "max_age_minutes": 120
  },
  "destination_weather": {
    "reference_directory": "data/reference/weather/2024-2025-destination-v1"
  },
  "benchmark": {
    "workers": [
      "local[2]",
      "local[4]",
      "local[8]"
    ],
    "data_fractions": [
      0.1,
      0.5,
      1.0
    ],
    "fixed_worker_for_size_scaling": "local[4]",
    "seed": 42,
    "poll_interval_seconds": 0.25
  }
}
